# Contexto de build del servidor central.
# El Dockerfile necesita: manifests de los 2 workspaces, shared/ y server/.
# El agente Windows (.NET) no se compila aquí (ver agent-dotnet/ y el Dockerfile).

# VCS / CI / docs
.git
.github
docs
*.md

# Artefactos y entorno local
node_modules
**/node_modules
run
.env
.env.*

# Datos locales del servidor (el contenedor usa un volumen)
server/data

# Tests y utilidades de desarrollo (el runtime no los importa)
tests
scripts
bunfig.toml

# Agente Windows: se compila en la etapa agent-builder del Dockerfile.
# Solo se ignora el output de build local (bin/obj); el código fuente
# (incluido el .csproj) debe entrar al contexto.
agent-dotnet/bin
agent-dotnet/obj
dist
