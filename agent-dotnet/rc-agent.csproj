<Project Sdk="Microsoft.NET.Sdk">

  <!--
    rc-agent (C# port of the TypeScript agent).

    net8.0-windows + UseWindowsForms is what brings in the desktop APIs the
    port needs: System.Windows.Automation (UIA) for window/element trees,
    NotifyIcon for the tray, and System.Drawing for screen capture. Windows is
    also the only place this can be built: the WindowsDesktop runtime does not
    exist for Linux, so `dotnet publish` must run on the agent machine (or a
    Windows builder).

    SelfContained=false keeps the binary ~2 MB and relies on the .NET 8 runtime
    installed on the machine (the SDK install provides it).
  -->
  <PropertyGroup>
    <!-- Version comes from the repo's single source of truth so hello/info
         match the hub. -->
    <RepoVersionFile>$(MSBuildThisFileDirectory)../shared/version.ts</RepoVersionFile>
    <RepoVersionRaw Condition="Exists('$(RepoVersionFile)')">$([System.IO.File]::ReadAllText('$([System.IO.Path]::GetFullPath('$(RepoVersionFile)'))'))</RepoVersionRaw>
    <RepoVersion>$([System.Text.RegularExpressions.Regex]::Match('$(RepoVersionRaw)', 'VERSION\s*=\s*"([0-9]+\.[0-9]+\.[0-9]+)"').Groups[1].Value)</RepoVersion>
    <Version Condition="'$(RepoVersion)' != ''">$(RepoVersion)</Version>
    <InformationalVersion Condition="'$(RepoVersion)' != ''">$(RepoVersion)</InformationalVersion>
    <FileVersion Condition="'$(RepoVersion)' != ''">$(RepoVersion).0</FileVersion>
    <AssemblyVersion Condition="'$(RepoVersion)' != ''">$(RepoVersion).0</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF is never touched: dropping it keeps the self-contained build lean.
         Trimming stays OFF: the SDK refuses to trim with WinForms enabled (it
         is reflection-heavy) and a trimmed tray/UIA build would be a runtime
         gamble on the target machine. -->
    <UseWPF>false</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>rc-agent</AssemblyName>
    <RootNamespace>Mrc.Agent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The tray/desktop bits make the SDK emit a windowed app; keep stderr. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- We never touch WPF, but the WindowsDesktop runtime pack ships its
         native DLLs anyway; drop them so the self-contained build stays lean. -->
    <None Include="$(PublishDir)**\*wpf*" />
  </ItemGroup>

  <Target Name="DropWpfNativeDlls" AfterTargets="Publish">
    <ItemGroup>
      <WpfJunk Include="$(PublishDir)wpfgfx_cor3.dll" />
      <WpfJunk Include="$(PublishDir)PresentationNative_cor3.dll" />
      <WpfJunk Include="$(PublishDir)PenImc_cor3.dll" />
      <WpfJunk Include="$(PublishDir)D3DCompiler_47_cor3.dll" />
    </ItemGroup>
    <Delete Files="@(WpfJunk)" ContinueOnError="true" />
    <Message Importance="high" Text="Dropped unused WPF native dlls from $(PublishDir)" />
  </Target>

  <ItemGroup>
    <!-- FlaUI/UIA use COM interop and reflection: keep those assemblies whole. -->
    <TrimmerRootAssembly Include="FlaUI.Core" />
    <TrimmerRootAssembly Include="FlaUI.UIA3" />
    <TrimmerRootAssembly Include="Interop.UIAutomationClient" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <!-- WMI: System.Management is not in the BCL on .NET (it was on Framework). -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- UIA: FlaUI replaces our hand-rolled mrc-cua.cs engine (which needed a
         runtime csc compile on the target). Pure NuGet, so no sidecar, no
         compiled-in-source, no .sha marker. -->
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>


</Project>
