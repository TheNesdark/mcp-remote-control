# /etc/mcp-remote-control/env — server settings for the systemd unit.
# Copy this file there and set MRC_TOKEN (and MRC_HOST if it is not the LAN IP).
#
# Deliberately short: paths derive from MRC_DATA_DIR, the auto-update version
# comes from the build (shared/version.ts) and the limits have sane defaults.
# See docs/OPERATIONS.md for the full list of optional variables.

# LAN address of this host (agents and opencode connect to it).
# 0.0.0.0 listens on every interface.
MRC_HOST=0.0.0.0
MRC_PORT=8787

# Shared secret: agent legacy-token fallback AND Bearer for MCP over HTTP.
# Generate one with: openssl rand -base64 24
MRC_TOKEN=change-me-to-something-long-and-random

# Production: enroll per-agent tokens and refuse the shared one for agents.
# bun run admin -- agent add --name PC-01   (run as the mrc user with MRC_DB_PATH set)
MRC_REQUIRE_DB_TOKENS=1

# Everything else (mcp.db, audit.jsonl, screenshots/) lives in this directory.
MRC_DATA_DIR=/opt/mcp-remote-control/server/data

# MCP over Streamable HTTP for opencode-as-remote-client (same host/port rules).
MRC_MCP_HTTP_PORT=8788

# Auto-update (OTA): publish an agent build without extra variables.
# MRC_AGENT_BINARY_PATH defaults to <repo>/agent/rc-agent.exe when present, and
# its sha256 is computed at boot. Only needed if the exe lives elsewhere.
# MRC_AGENT_BINARY_PATH=/opt/mcp-remote-control/dist/rc-agent.exe

# Optional TLS on BOTH faces (wss:// for agents, https:// for MCP).
# Self-signed LAN certificate:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
#     -keyout /etc/mcp-remote-control/tls.key -out /etc/mcp-remote-control/tls.crt \
#     -subj "/CN=mrc.lan" -addext "subjectAltName=IP:192.168.1.50,DNS:localhost"
# Agents: pass --tls-insecure or MRC_TLS_INSECURE=1 (or trust the CA via
# NODE_EXTRA_CA_CERTS). Leave unset for plain ws://+http:// on a trusted LAN.
# MRC_TLS_CERT=/etc/mcp-remote-control/tls.crt
# MRC_TLS_KEY=/etc/mcp-remote-control/tls.key

# --- Cua Driver (computer use) ---------------------------------------------
# Nothing needed in normal operation: the image ships the pinned driver zip
# (shared/cua-version.ts) and agents provision it from the hub automatically.
# Only overrides:
# MRC_CUA_DRIVER_PATH=/app/agent/cua-driver.zip
# MRC_CUA_DRIVER_VERSION=0.36.0
# MRC_CUA_DRIVER_SHA256=<64 hex>
